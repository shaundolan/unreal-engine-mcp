{
  "id": "scene-greybox-arena",
  "domain": "scene",
  "title": "Greybox arena",
  "prompt": "Greybox an arena: a floor at least 4000x4000 units centred on the origin, four walls at least 300 units tall enclosing it, a PlayerStart inside the arena, a DirectionalLight and a SkyLight.",
  "setup": [],
  "check": {
    "scene": [
      {
        "type": "python",
        "expr": "any(a.get_actor_bounds(False)[1].x >= 1990 and a.get_actor_bounds(False)[1].y >= 1990 and a.get_actor_bounds(False)[1].z <= 100 for a in actors)",
        "name": "floor 4000x4000"
      },
      {
        "type": "python",
        "expr": "len([a for a in actors if a.get_actor_bounds(False)[1].z * 2 >= 300 and max(a.get_actor_bounds(False)[1].x, a.get_actor_bounds(False)[1].y) >= 1500 and min(a.get_actor_bounds(False)[1].x, a.get_actor_bounds(False)[1].y) < 500]) >= 4",
        "name": "4 tall walls"
      },
      {
        "type": "python",
        "expr": "any(isinstance(a, unreal.PlayerStart) and abs(a.get_actor_location().x) < 2000 and abs(a.get_actor_location().y) < 2000 for a in actors)",
        "name": "PlayerStart inside"
      },
      {
        "type": "actor_exists",
        "class": "DirectionalLight"
      },
      {
        "type": "actor_exists",
        "class": "SkyLight"
      }
    ]
  },
  "solution": [
    {
      "tool": "scene_compose",
      "args": {
        "operations": [
          {
            "op": "spawn",
            "asset": "/Engine/BasicShapes/Cube.Cube",
            "label": "Floor",
